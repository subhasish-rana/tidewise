# =============================================================================
#  Tidewise – Environment variable reference
#  Copy this file to .env and fill in your values.
#  NEVER commit .env or any file containing real credentials to git.
# =============================================================================

# PORT: Port the Tidewise Express server listens on (defaults to 3000).
PORT=3000

# HOST: Interface to bind.
#   127.0.0.1 — local-only (default, recommended for development)
#   0.0.0.0   — all interfaces (only use behind a reverse proxy in production)
HOST=127.0.0.1

# NODE_ENV: Set to "production" for a production build.
#   In production the server serves the compiled dist/ folder and applies
#   a stricter Content-Security-Policy.
NODE_ENV=development

